*.mp4 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text

# The static viewer must be served as real files (Vercel does not fetch LFS objects);
# this later rule overrides the LFS rules above for everything under web/.
web/** -filter -diff -merge
